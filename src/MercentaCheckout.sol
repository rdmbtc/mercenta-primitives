pragma solidity ^0.8.20;

interface IERC20 {
    function balanceOf(address account) external view returns (uint256);
    function transfer(address recipient, uint256 amount) external returns (bool);
    function transferFrom(address sender, address recipient, uint256 amount) external returns (bool);
}

/**
 * @title MercentaCheckout
 * @notice Production-grade checkout router for autonomous agent commerce settled on Arc in USDC.
 * @dev Enforces single append-only receipts, circuit breakers, and deterministic fee routing.
 */
contract MercentaCheckout {
    address public constant CANONICAL_USDC = 0x3600000000000000000000000000000000000000;
    uint256 public constant CHAIN_ID_MAINNET = 5042;
    uint256 public constant BPS_DENOMINATOR = 10000;

    address public owner;
    address public merchantTreasury;
    address public feeTreasury;
    uint256 public platformFeeBps; // e.g. 50 = 0.50%
    bool public paused;

    mapping(bytes32 => bool) public processedOrders;

    event OrderPlaced(
        bytes32 indexed orderId,
        address indexed buyer,
        address indexed supplier,
        uint256 totalAmountUsdc,
        uint256 netSupplierAmountUsdc,
        uint256 feeAmountUsdc,
        string productReference
    );
    event CircuitBreakerToggled(bool isPaused);
    event TreasuryUpdated(address indexed merchant, address indexed fee);
    event PlatformFeeUpdated(uint256 feeBps);

    error Unauthorized();
    error ContractPaused();
    error DuplicateOrder();
    error InvalidAmount();
    error TransferFailed();

    modifier onlyOwner() {
        if (msg.sender != owner) revert Unauthorized();
        _;
    }

    modifier whenNotPaused() {
        if (paused) revert ContractPaused();
        _;
    }

    constructor(
        address merchantTreasury_,
        address feeTreasury_,
        uint256 platformFeeBps_
    ) {
        owner = msg.sender;
        merchantTreasury = merchantTreasury_;
        feeTreasury = feeTreasury_;
        platformFeeBps = platformFeeBps_;
    }

    function setPaused(bool paused_) external onlyOwner {
        paused = paused_;
        emit CircuitBreakerToggled(paused_);
    }

    function setTreasuries(address merchantTreasury_, address feeTreasury_) external onlyOwner {
        merchantTreasury = merchantTreasury_;
        feeTreasury = feeTreasury_;
        emit TreasuryUpdated(merchantTreasury_, feeTreasury_);
    }

    function setPlatformFeeBps(uint256 feeBps_) external onlyOwner {
        require(feeBps_ <= 1000, "FEE_TOO_HIGH"); // Max 10%
        platformFeeBps = feeBps_;
        emit PlatformFeeUpdated(feeBps_);
    }

    /**
     * @notice Executes checkout settlement for an autonomous agent order intent.
     * @param orderId Deterministic order ID generated by agent policy gate.
     * @param supplier The approved digital goods / compute provider.
     * @param totalAmountUsdc Total gross order amount in 6-decimal USDC.
     * @param productReference Monospace SKU / metadata string.
     */
    function checkout(
        bytes32 orderId,
        address supplier,
        uint256 totalAmountUsdc,
        string calldata productReference
    ) external whenNotPaused {
        if (totalAmountUsdc == 0) revert InvalidAmount();
        if (processedOrders[orderId]) revert DuplicateOrder();

        processedOrders[orderId] = true;

        uint256 feeAmount = (totalAmountUsdc * platformFeeBps) / BPS_DENOMINATOR;
        uint256 supplierAmount = totalAmountUsdc - feeAmount;

        // Atomic 6-decimal USDC routing
        IERC20 token = IERC20(CANONICAL_USDC);
        if (feeAmount > 0 && feeTreasury != address(0)) {
            if (!token.transferFrom(msg.sender, feeTreasury, feeAmount)) revert TransferFailed();
        }
        address recipient = supplier != address(0) ? supplier : merchantTreasury;
        if (!token.transferFrom(msg.sender, recipient, supplierAmount)) revert TransferFailed();

        emit OrderPlaced(
            orderId,
            msg.sender,
            recipient,
            totalAmountUsdc,
            supplierAmount,
            feeAmount,
            productReference
        );
    }
}
